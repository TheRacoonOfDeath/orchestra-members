msgid "Every field needs a label."
msgstr "Jedes Feld braucht eine Bezeichnung."

#. translators: 1: field label, 2: maximum number of characters
#: src/Profile/ProfileFieldsInput.php:118
#, php-format
msgid "The label \"%1$s\" is longer than %2$d characters."
msgstr "Die Bezeichnung „%1$s“ ist länger als %2$d Zeichen."

#. translators: 1: field label, 2: maximum number of characters
#: src/Profile/ProfileFieldsInput.php:123
#, php-format
msgid "The hint of \"%1$s\" is longer than %2$d characters."
msgstr "Der Hinweis zu „%1$s“ ist länger als %2$d Zeichen."

#. translators: %s: field label
#: src/Profile/ProfileFieldsInput.php:151
#, php-format
msgid "Please enter the choices for \"%s\", one per line."
msgstr "Bitte gib die Auswahlmöglichkeiten für „%s“ ein, eine pro Zeile."

#. translators: 1: choice, 2: maximum number of characters
#: src/Profile/ProfileFieldsInput.php:156
#, php-format
msgid "The choice \"%1$s\" is longer than %2$d characters."
msgstr "Die Auswahlmöglichkeit „%1$s“ ist länger als %2$d Zeichen."

