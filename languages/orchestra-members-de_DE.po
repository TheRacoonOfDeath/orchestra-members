#: src/Profile/ProfileFieldsInput.php:176
#, php-format
msgid "The label \"%s\" is used more than once."
msgstr "Die Bezeichnung „%s“ wird mehrfach verwendet."

#: src/Status/LoginBlocker.php:57
msgid ""
"Your account has been marked as inactive. Please contact an administrator to "
"reactivate it."
msgstr ""
"Dein Konto wurde als inaktiv markiert. Bitte wende dich an einen "
"Administrator, um es zu reaktivieren."

#: src/Status/StatusService.php:31
msgid "Only users with an orchestra role can be set inactive."
msgstr ""
"Nur Benutzer mit einer Orchesterrolle können auf inaktiv gesetzt werden."

#: src/Status/StatusService.php:34
msgid "Administrators cannot be set inactive."
msgstr "Administratoren können nicht auf inaktiv gesetzt werden."

#: src/Status/StatusService.php:37
msgid "You cannot change your own status."
msgstr "Du kannst deinen eigenen Status nicht ändern."

